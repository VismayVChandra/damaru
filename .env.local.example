# Copy to .env.local and fill in from your Supabase project's
# Settings -> API page. .env.local is gitignored - never commit real values.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret. Bypasses every permission check in the database - never expose this
# to the browser, never commit it, never paste it anywhere but here.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
